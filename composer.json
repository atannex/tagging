{
    "name": "atannex/tagging",
    "description": "Contextual taxonomies and polymorphic tagging for Laravel: tenants, aliases, hierarchy, translations, weighted and expiring assignments.",
    "keywords": [
        "laravel",
        "eloquent",
        "tagging",
        "tags",
        "taxonomy",
        "categories",
        "multi-tenant",
        "hierarchy",
        "polymorphic"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/atannex/tagging",
    "authors": [
        {
            "name": "Atanga Leke Collins",
            "email": "atangageihlekecollins@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/atannex/tagging/issues",
        "source": "https://github.com/atannex/tagging",
        "security": "https://github.com/atannex/tagging/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Atannex\\Tagging\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atannex\\Tagging\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atannex\\Tagging\\TaggingServiceProvider"
            ],
            "aliases": {
                "Tagging": "Atannex\\Tagging\\Facades\\Tagging"
            }
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:mysql": "bash scripts/test-database mysql",
        "test:pgsql": "bash scripts/test-database pgsql",
        "format": "pint",
        "format:check": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
