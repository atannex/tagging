 * Creates a new DateInterval object
 * @param string $duration An interval specification. The format starts with the letter P, for
 * period. Each duration period is represented by an integer value followed by a period
 * designator. If the duration contains time elements, that portion of the specification is
 * preceded by the letter T. duration Period Designators Period Designator Description Y years M
 * months D days W weeks. Converted into days. Prior to PHP 8.0.0, can not be combined with D. H
 * hours M minutes S seconds Here are some simple examples. Two days is P2D. Two seconds is
 * PT2S. Six years and five minutes is P6YT5M. The unit types must be entered from the largest
 * scale unit on the left to the smallest scale unit on the right. So years before months,
 * months before days, days before minutes, etc. Thus one year and four days must be represented
 * as P1Y4D, not P4D1Y. The specification can also be represented as a date time. A sample of
 * one year and four days would be P0001-00-04T00:00:00. But the values in this format can not
 * exceed a given period's roll-over-point (e.g. 25 hours is invalid). These formats are based
 * on the ISO 8601 duration specification.
 * @throws DateMalformedIntervalStringException when the $duration cannot be parsed as an interval.
 * @link https://php.net/manual/en/dateinterval.construct.php
 */";s:9:"startLine";i:76;s:7:"endLine";i:82;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:12:"DateInterval";s:21:"implementingClassName";s:12:"DateInterval";s:16:"currentClassName";s:12:"DateInterval";s:9:"aliasName";N;}s:6:"format";a:20:{s:4:"name";s:6:"format";s:10:"parameters";a:1:{s:6:"format";a:14:{s:4:"name";s:6:"format";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:1:{i:0;a:3:{s:4:"name";s:50:"JetBrains\PhpStorm\Internal\LanguageLevelTypeAware";s:10:"isRepeated";b:0;s:9:"arguments";a:2:{i:0;a:2:{s:4:"code";s:19:"['8.0' => 'string']";s:10:"attributes";a:6:{s:9:"startLine";i:103;s:7:"endLine";i:103;s:13:"startTokenPos";i:141;s:12:"startFilePos";i:4676;s:11:"endTokenPos";i:147;s:10:"endFilePos";i:4694;}}s:7:"default";a:2:{s:4:"code";s:2:"''";s:10:"attributes";a:6:{s:9:"startLine";i:103;s:7:"endLine";i:103;s:13:"startTokenPos";i:153;s:12:"startFilePos";i:4706;s:11:"endTokenPos";i:153;s:10:"endFilePos";i:4707;}}}}}s:9:"startLine";i:103;s:7:"endLine";i:104;s:11:"startColumn";i:13;s:9:"endColumn";i:26;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:1:{i:0;a:3:{s:4:"name";s:41:"JetBrains\PhpStorm\Internal\TentativeType";s:10:"isRepeated";b:0;s:9:"arguments";a:0:{}}}s:10:"docComment";s:1271:"/**
 * Formats the interval
 * @param string $format The following characters are recognized in the format parameter string.
 * Each format character must be prefixed by a percent sign (%). format character Description
 * Example values % Literal % % Y Years, numeric, at least 2 digits with leading 0 01, 03 y
 * Years, numeric 1, 3 M Months, numeric, at least 2 digits with leading 0 01, 03, 12 m Months,
 * numeric 1, 3, 12 D Days, numeric, at least 2 digits with leading 0 01, 03, 31 d Days, numeric
 * 1, 3, 31 a Total number of days as a result of a DateTime::diff or (unknown) otherwise 4, 18,
 * 8123 H Hours, numeric, at least 2 digits with leading 0 01, 03, 23 h Hours, numeric 1, 3, 23
 * I Minutes, numeric, at least 2 digits with leading 0 01, 03, 59 i Minutes, numeric 1, 3, 59 S
 * Seconds, numeric, at least 2 digits with leading 0 01, 03, 57 s Seconds, numeric 1, 3, 57 F
 * Microseconds, numeric, at least 6 digits with leading 0 007701, 052738, 428291 f
 * Microseconds, numeric 7701, 52738, 428291 R Sign "-" when negative, "+" when positive -, + r
 * Sign "-" when negative, empty when positive -,
 * @return string Returns the formatted interval.
 * @link https://php.net/manual/en/dateinterval.format.php
 * @betterReflectionTentativeReturnType
 */";s:9:"startLine";i:101;s:7:"endLine";i:107;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:12:"DateInterval";s:21:"implementingClassName";s:12:"DateInterval";s:16:"currentClassName";s:12:"DateInterval";s:9:"aliasName";N;}s:20:"createFromDateString";a:20:{s:4:"name";s:20:"createFromDateString";s:10:"parameters";a:1:{s:8:"datetime";a:14:{s:4:"name";s:8:"datetime";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:1:{i:0;a:3:{s:4:"name";s:50:"JetBrains\PhpStorm\Internal\LanguageLevelTypeAware";s:10:"isRepeated";b:0;s:9:"arguments";a:2:{i:0;a:2:{s:4:"code";s:19:"['8.0' => 'string']";s:10:"attributes";a:6:{s:9:"startLine";i:124;s:7:"endLine";i:124;s:13:"startTokenPos";i:217;s:12:"startFilePos";i:5958;s:11:"endTokenPos";i:223;s:10:"endFilePos";i:5976;}}s:7:"default";a:2:{s:4:"code";s:2:"''";s:10:"attributes";a:6:{s:9:"startLine";i:124;s:7:"endLine";i:124;s:13:"startTokenPos";i:229;s:12:"startFilePos";i:5988;s:11:"endTokenPos";i:229;s:10:"endFilePos";i:5989;}}}}}s:9:"startLine";i:124;s:7:"endLine";i:125;s:11:"startColumn";i:13;s:9:"endColumn";i:28;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";N;s:10:"attributes";a:3:{i:0;a:3:{s:4:"name";s:41:"JetBrains\PhpStorm\Internal\TentativeType";s:10:"isRepeated";b:0;s:9:"arguments";a:0:{}}i:1;a:3:{s:4:"name";s:57:"JetBrains\PhpStorm\Internal\PhpStormStubsElementAvailable";s:10:"isRepeated";b:0;s:9:"arguments";a:1:{s:4:"from";a:2:{s:4:"code";s:5:"'8.3'";s:10:"attributes";a:6:{s:9:"startLine";i:121;s:7:"endLine";i:121;s:13:"startTokenPos";i:182;s:12:"startFilePos";i:5710;s:11:"endTokenPos";i:182;s:10:"endFilePos";i:571