 * (PHP 8 &gt;=8.3.0)<br/>
 * @link https://php.net/manual/en/datetimeimmutable.construct.php
 * @param string $datetime [optional]
 * <p>A date/time string. Valid formats are explained in {@link https://php.net/manual/en/datetime.formats.php Date and Time Formats}.</p>
 * <p>Enter <b>'now'</b> here to obtain the current time when using the <em>$timezone</em> parameter.</p>
 * @param null|DateTimeZone $timezone [optional] <p>
 * A {@link https://php.net/manual/en/class.datetimezone.php DateTimeZone} object representing the timezone of <em>$datetime</em>.
 * </p>
 * <p>If <em>$timezone</em> is omitted, the current timezone will be used.</p>
 * <blockquote><p><b>Note</b>:</p><p>
 * The <em>$timezone</em> parameter and the current timezone are ignored when the <em>$datetime</em> parameter either
 * is a UNIX timestamp (e.g. <em>@946684800</em>) or specifies a timezone (e.g. <em>2010-01-28T15:00:00+02:00</em>).
 * </p></blockquote>
 * @throws DateMalformedStringException Emits Exception in case of an error.
 */";s:9:"startLine";i:31;s:7:"endLine";i:39;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:17:"DateTimeImmutable";s:21:"implementingClassName";s:17:"DateTimeImmutable";s:16:"currentClassName";s:17:"DateTimeImmutable";s:9:"aliasName";N;}s:3:"add";a:20:{s:4:"name";s:3:"add";s:10:"parameters";a:1:{s:8:"interval";a:14:{s:4:"name";s:8:"interval";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:12:"DateInterval";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:50;s:7:"endLine";i:50;s:11:"startColumn";i:29;s:9:"endColumn";i:51;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:17:"DateTimeImmutable";s:12:"isIdentifier";b:0;}}s:10:"attributes";a:2:{i:0;a:3:{s:4:"name";s:41:"JetBrains\PhpStorm\Internal\TentativeType";s:10:"isRepeated";b:0;s:9:"arguments";a:0:{}}i:1;a:3:{s:4:"name";s:9:"NoDiscard";s:10:"isRepeated";b:0;s:9:"arguments";a:1:{s:7:"message";a:2:{s:4:"code";s:63:""as DateTimeImmutable::add() does not modify the object itself"";s:10:"attributes";a:6:{s:9:"startLine";i:49;s:7:"endLine";i:49;s:13:"startTokenPos";i:112;s:12:"startFilePos";i:2491;s:11:"endTokenPos";i:112;s:10:"endFilePos";i:2553;}}}}}s:10:"docComment";s:340:"/**
