 * Get the current interval in a human readable format in the current locale.
 *
 * @example
 * ```
 * echo CarbonInterval::fromString('4d 3h 40m')->forHumans() . "\n";
 * echo CarbonInterval::fromString('4d 3h 40m')->forHumans(['parts' => 2]) . "\n";
