 * (PHP 5 >= 5.1.0, PHP 7, PHP 8, PECL pdo &gt;= 0.2.0)<br/>
 * Executes an SQL statement, returning a result set as a PDOStatement object
 * @link https://php.net/manual/en/pdo.query.php
 * @param string $query <p>
 * The SQL statement to prepare and execute.
 * </p>
 * <p>
 * Data inside the query should be properly escaped.
 * </p>
 * @param int|null $fetchMode <p>
 * The fetch mode must be one of the PDO::FETCH_* constants.
 * </p>
 * @param mixed ...$fetch_mode_args <p>
 * Arguments of custom class constructor when the <i>mode</i>
 * parameter is set to <b>PDO::FETCH_CLASS</b>.
 * </p>
 * @return PDOStatement|false <b>PDO::query</b> returns a PDOStatement object, or <b>FALSE</b>
 * on failure or emits <b>PDOException</b> (depending on error handling).
 * @throws PDOException On error if PDO::ERRMODE_EXCEPTION option is true.
 * @see PDOStatement::setFetchMode For a full description of the second and following parameters.
 * @betterReflectionTentativeReturnType
 */";s:9:"startLine";i:1159;s:7:"endLine";i:1170;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:1;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:3:"PDO";s:21:"implementingClassName";s:3:"PDO";s:16:"currentClassName";s:3:"PDO";s:9:"aliasName";N;}s:12:"lastInsertId";a:20:{s:4:"name";s:12:"lastInsertId";s:10:"parameters";a:1:{s:4:"name";a:14:{s:4:"name";s:4:"name";s:7:"default";a:2:{s:4:"code";s:5:"\null";s:10:"attributes";a:6:{s:9:"startLine";i:1199;s:7:"endLine";i:1199;s:13:"startTokenPos";i:3758;s:12:"startFilePos";i:55517;s:11:"endTokenPos";i:3758;s:10:"endFilePos";i:55520;}}s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"null";s:12:"isIdentifier";b:1;}}}}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:1:{i:0;a:3:{s:4:"name";s:50:"JetBrains\PhpStorm\Internal\LanguageLevelTypeAware";s:10:"isRepeated";b:0;s:9:"arguments";a:2:{i:0;a:2:{s:4:"code";s:24:"['8.0' => 'string|null']";s:10:"attributes";a:6:{s:9:"startLine";i:1198;s:7:"endLine";i:1198;s:13:"startTokenPos";i:3734;s:12:"startFilePos";i:55445;s:11:"endTokenPos";i:3740;s:10:"endFilePos";i:55468;}}s:7:"default";a:2:{s:4:"code";s:2:"''";s:10:"attributes";a:6:{s:9:"startLine";i:1198;s:7:"endLine";i:1198;s:13:"startTokenPos";i:3746;s:12:"startFilePos";i:55480;s:11:"endTokenPos";i:3746;s:10:"endFilePos";i:55481;}}}}}s:9:"startLine";i:1198;s:7:"endLine";i:1199;s:11:"startColumn";i:13;s:9:"endColumn";i:36;s:14:"parameterIndex";i:0;s:10:"isOptional";b:1;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\Bett